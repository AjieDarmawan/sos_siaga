{
  "name": "@siagasos/react",
  "version": "0.1.0",
  "description": "SiagaSOS untuk React: <SOSProvider>, <SOSButton>, useSOS()",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17",
    "@siagasos/js": "workspace:^"
  },
  "devDependencies": {
    "@siagasos/js": "workspace:*",
    "@siagasos/shared": "workspace:*",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}